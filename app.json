{
  "expo": {
    "name": "360° Fitness",
    "slug": "nufit-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "nufit",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nufit.app"
    },
    "android": {
      "package": "com.nufit.app",
      "adaptiveIcon": {
        "backgroundColor": "#EBA3B6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F3"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose your front and side photos so Dr. Kanika's team can track your progress.",
          "cameraPermission": "Take your front and side photos so Dr. Kanika's team can track your progress.",
          "microphonePermission": false
        }
      ],
      "expo-video"
    ]
  }
}
